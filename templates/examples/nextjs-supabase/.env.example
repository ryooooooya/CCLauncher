APP_ORIGIN=https://127.0.0.1:3443
# Opt in only for an isolated local HTTP fixture. Never enable in a deployment.
CCLAUNCHER_LOCAL_HTTP=false
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key
# Never put service-role credentials in application/browser configuration.
# pnpm fixtures creates local-only .env.local and .env.test from Supabase CLI status.
