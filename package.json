{
  "name": "@ryooooooya/cclauncher",
  "version": "0.1.0",
  "description": "Model-agnostic development harness for secure web applications",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryooooooya/CCLauncher.git"
  },
  "bin": {
    "cclauncher": "dist/cli/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
